---
// A short, tilted, static ribbon helix inside a faint cloud of nucleotide
// letters. Drawn once, and redrawn only on resize.
interface Props {
  width?: number;
  height?: number;
  tilt?: number; // degrees from vertical; positive leans the top to the right
}

const { width = 260, height = 320, tilt = 28 } = Astro.props;
---

<dna-helix
  style={`--helix-width: ${width}px; --helix-height: ${height}px`}
  data-tilt={tilt}
  aria-hidden="true"
>
  <canvas></canvas>
</dna-helix>

<style>
  dna-helix {
    display: block;
    width: var(--helix-width);
    max-width: 100%;
    height: var(--helix-height);
    color: var(--text-primary);
    pointer-events: none;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const WAVELENGTH = 140; // px per helical turn
  const PHASE = 0.6; // rotation of the helix about its axis, in radians
  const BP_PER_TURN = 10;
  const STEP = 2; // px between sampled points along a strand
  const FADE = 0.2; // fraction of the length faded at each end
  const NUCLEOTIDES = "ACGT";

  const smoothstep = (t: number) => {
    const x = Math.min(Math.max(t, 0), 1);
    return x * x * (3 - 2 * x);
  };

  const parseRgb = (css: string) =>
    (css.match(/[\d.]+/g) ?? ["0", "0", "0"]).slice(0, 3).map(Number);

  // Deterministic PRNG so the letter cloud is identical on every load.
  const mulberry32 = (seed: number) => () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };

  class DNAHelix extends HTMLElement {
    canvas!: HTMLCanvasElement;
    ctx!: CanvasRenderingContext2D;
    cloud = document.createElement("canvas");
    width = 0;
    height = 0;
    dpr = 1;
    length = 0;
    radius = 0;
    axis = { x: 0, y: -1 };
    perp = { x: 1, y: 0 };
    ink = [0, 0, 0];
    paper = [255, 255, 255];
    resizeObserver?: ResizeObserver;

    connectedCallback() {
      this.canvas = this.querySelector("canvas")!;
      this.ctx = this.canvas.getContext("2d")!;

      const tilt = ((Number(this.dataset.tilt) || 0) * Math.PI) / 180;
      this.axis = { x: Math.sin(tilt), y: -Math.cos(tilt) };
      this.perp = { x: Math.cos(tilt), y: Math.sin(tilt) };

      this.resizeObserver = new ResizeObserver(() => {
        this.resize();
        this.draw();
      });
      this.resizeObserver.observe(this);
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
    }

    resize() {
      this.dpr = window.devicePixelRatio || 1;
      const rect = this.getBoundingClientRect();
      this.width = rect.width;
      this.height = rect.height;
      for (const c of [this.canvas, this.cloud]) {
        c.width = Math.round(rect.width * this.dpr);
        c.height = Math.round(rect.height * this.dpr);
      }
      this.ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);

      const tiltCos = Math.abs(this.axis.y);
      this.length = (this.height / tiltCos) * 0.95;
      this.radius = Math.min(this.width * 0.15, 38);
      this.drawCloud();
    }

    // Solid colour equivalent to ink at the given opacity over the page
    // background. Overlapping strokes then don't darken into visible beads.
    shade(opacity: number) {
      const [r, g, b] = this.ink.map(
        (c, i) => this.paper[i] + (c - this.paper[i]) * opacity
      );
      return `rgb(${r}, ${g}, ${b})`;
    }

    // Map helix-local coordinates (u along the axis, v across it) to screen.
    toScreen(u: number, v: number) {
      return {
        x: this.width / 2 + u * this.axis.x + v * this.perp.x,
        y: this.height / 2 + u * this.axis.y + v * this.perp.y,
      };
    }

    endFade(u: number) {
      const t = u / this.length + 0.5;
      return smoothstep(t / FADE) * smoothstep((1 - t) / FADE);
    }

    // Static backdrop of sequence letters, densest along the helix axis.
    drawCloud() {
      const ctx = this.cloud.getContext("2d")!;
      ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
      ctx.clearRect(0, 0, this.width, this.height);
      ctx.fillStyle = getComputedStyle(this).color;
      ctx.font = "500 9px ui-monospace, SFMono-Regular, Menlo, monospace";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      const rand = mulberry32(17);
      const band = this.radius * 2.4;
      for (let v = -band; v <= band; v += 11) {
        for (let u = -this.length / 2; u <= this.length / 2; u += 8) {
          if (rand() > 0.5) continue;
          const letter = NUCLEOTIDES[Math.floor(rand() * 4)];
          const falloff = Math.pow(1 - Math.abs(v) / band, 1.4);
          ctx.globalAlpha = 0.2 * falloff * this.endFade(u);
          const p = this.toScreen(u, v);
          ctx.fillText(letter, p.x, p.y);
        }
      }
    }

    angle(u: number) {
      return (2 * Math.PI * u) / WAVELENGTH + PHASE;
    }

    drawStrand(offset: number, front: boolean) {
      const { ctx, radius } = this;
      for (let u = -this.length / 2; u < this.length / 2; u += STEP) {
        const a0 = this.angle(u) + offset;
        const a1 = this.angle(u + STEP) + offset;
        const depth = (Math.cos((a0 + a1) / 2) + 1) / 2; // 1 = nearest
        if (depth >= 0.5 !== front) continue;

        const fade = this.endFade(u);
        if (fade <= 0) continue;
        ctx.strokeStyle = this.shade((0.18 + 0.82 * depth) * fade);
        ctx.lineWidth = 1.5 + 3.5 * depth;
        const p0 = this.toScreen(u, radius * Math.sin(a0));
        const p1 = this.toScreen(u + STEP, radius * Math.sin(a1));
        ctx.beginPath();
        ctx.moveTo(p0.x, p0.y);
        ctx.lineTo(p1.x, p1.y);
        ctx.stroke();
      }
    }

    // Each base pair is two half-rungs with a small gap, like paired bases.
    drawBasePairs() {
      const { ctx, radius } = this;
      const spacing = WAVELENGTH / BP_PER_TURN;
      const gap = 2;
      ctx.lineWidth = 2;

      for (let u = -this.length / 2 + spacing / 2; u < this.length / 2; u += spacing) {
        const a = this.angle(u);
        const v = radius * Math.sin(a);
        if (Math.abs(v) < gap + 1) continue;
        const fade = this.endFade(u);
        const depth = (Math.cos(a) + 1) / 2;
        const inner = Math.sign(v) * gap;

        for (const [from, to, d] of [
          [v, inner, depth],
          [-v, -inner, 1 - depth],
        ]) {
          ctx.strokeStyle = this.shade((0.12 + 0.3 * d) * fade);
          const p0 = this.toScreen(u, from);
          const p1 = this.toScreen(u, to);
          ctx.beginPath();
          ctx.moveTo(p0.x, p0.y);
          ctx.lineTo(p1.x, p1.y);
          ctx.stroke();
        }
      }
    }

    draw() {
      const { ctx, width, height } = this;
      if (!width || !height) return;

      ctx.clearRect(0, 0, width, height);
      ctx.globalAlpha = 1;
      ctx.drawImage(this.cloud, 0, 0, width, height);

      this.ink = parseRgb(getComputedStyle(this).color);
      this.paper = parseRgb(getComputedStyle(document.body).backgroundColor);
      ctx.lineCap = "round";
      // Back halves, then base pairs, then front halves.
      this.drawStrand(0, false);
      this.drawStrand(Math.PI, false);
      this.drawBasePairs();
      this.drawStrand(0, true);
      this.drawStrand(Math.PI, true);
    }
  }

  if (!customElements.get("dna-helix")) {
    customElements.define("dna-helix", DNAHelix);
  }
</script>
